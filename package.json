{
  "name": "@baselhusam/daily-hub",
  "version": "0.1.8",
  "description": "A personal command center for projects, tasks, and daily habits.",
  "license": "MIT",
  "author": "Basel Husam",
  "homepage": "https://baselhusam.github.io/daily-hub/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baselhusam/daily-hub.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "daily-hub": "./bin/daily-hub.js"
  },
  "files": [
    "bin",
    "prisma",
    "scripts/prisma-postinstall.mjs",
    "public/brand-mark.svg",
    ".next/standalone",
    ".next/static",
    "package.json"
  ],
  "scripts": {
    "dev": "mkdir -p .data/uploads && DATABASE_URL=file:./.data/data.db DAILYHUB_DATA_DIR=./.data npm run db:migrate && DATABASE_URL=file:./.data/data.db DAILYHUB_DATA_DIR=./.data next dev -p 9999",
    "build": "next build",
    "prepare-standalone": "node scripts/prepare-standalone.mjs",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --target=node22 --outfile=bin/daily-hub.js --format=cjs --banner:js=\"#!/usr/bin/env node\"",
    "build:seed": "esbuild prisma/seed.ts --bundle --platform=node --target=node22 --outfile=bin/seed.js --format=cjs --alias:server-only=./scripts/server-only-shim.js --alias:@=./src",
    "start": "next start -p 9999",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "node scripts/run-seed.mjs",
    "db:studio": "prisma studio",
    "postinstall": "node scripts/prisma-postinstall.mjs",
    "prepack": "npm run db:generate && npm run build && npm run prepare-standalone && npm run build:cli && npm run build:seed"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@prisma/get-platform": "^6.19.3",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.562.0",
    "motion": "^12.23.26",
    "next": "^15.5.6",
    "next-themes": "^0.4.6",
    "prisma": "^6.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.4.0",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "esbuild": "^0.25.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.6",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
