# Copy to .env and set a strong password for Postgres.
# Use the same value in both variables (Compose does not expand ${POSTGRES_PASSWORD} inside DATABASE_URL for host npm run dev).
POSTGRES_PASSWORD=
DATABASE_URL="postgresql://dailyhub:YOUR_PASSWORD_HERE@localhost:5432/dailyhub"

# Optional override for uploaded logos and SQLite CLI data.
# DAILYHUB_DATA_DIR="/custom/path"
