generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/postgres"
  binaryTargets = ["native", "darwin-arm64", "darwin", "windows", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  DONE
}

enum TaskStatus {
  TODO
  DOING
  DONE
}

enum EntityType {
  DAILY_TASK
  TASK
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  iconKey     String        @default("folder")
  logoUrl     String?
  color       String?
  dueDate     DateTime?     @db.Date
  status      ProjectStatus @default(ACTIVE)
  sortOrder   Int           @default(0)
  tasks       Task[]
  milestones  Milestone[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Milestone {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  dueDate   DateTime? @db.Date
  done      Boolean   @default(false)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Settings {
  id            String  @id @default("default")
  displayName   String  @default("You")
  role          String  @default("Operator")
  workspaceName String  @default("Personal HQ")
  showStreaks   Boolean @default(true)
  nudgeDays     Int     @default(7)
}

model Task {
  id               String     @id @default(cuid())
  projectId        String?
  project          Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title            String
  notes            String?
  dueDate          DateTime?
  status           TaskStatus @default(TODO)
  priority         Int        @default(0)
  estimatedMinutes Int?
  completedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model DailyTask {
  id        String    @id @default(cuid())
  title     String
  iconKey   String    @default("check")
  logoUrl   String?
  weekdays  Json      @default("[0,1,2,3,4,5,6]")
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model CompletionLog {
  id          String     @id @default(cuid())
  entityType  EntityType
  entityId    String
  completedOn DateTime   @db.Date
  completedAt DateTime   @default(now())
  minutes     Int?
  note        String?

  @@unique([entityType, entityId, completedOn])
  @@index([completedOn])
  @@index([completedAt])
  @@index([entityType, entityId])
}
