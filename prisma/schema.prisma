generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  DONE
}

enum TaskStatus {
  TODO
  DOING
  DONE
}

enum EntityType {
  DAILY_TASK
  TASK
}

model Business {
  id         String      @id @default(cuid())
  name       String
  slug       String      @unique
  iconKey    String      @default("briefcase")
  logoUrl    String?
  color      String      @default("#737373")
  sortOrder  Int         @default(0)
  projects   Project[]
  tasks      Task[]
  dailyTasks DailyTask[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Project {
  id          String        @id @default(cuid())
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  iconKey     String        @default("folder")
  color       String?
  status      ProjectStatus @default(ACTIVE)
  sortOrder   Int           @default(0)
  tasks       Task[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Task {
  id          String     @id @default(cuid())
  businessId  String?
  business    Business?  @relation(fields: [businessId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title       String
  notes       String?
  dueDate     DateTime?
  status      TaskStatus @default(TODO)
  priority    Int        @default(0)
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model DailyTask {
  id          String          @id @default(cuid())
  businessId  String?
  business    Business?       @relation(fields: [businessId], references: [id], onDelete: SetNull)
  title       String
  iconKey     String          @default("check")
  sortOrder   Int             @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CompletionLog {
  id          String     @id @default(cuid())
  entityType  EntityType
  entityId    String
  completedOn DateTime   @db.Date
  completedAt DateTime   @default(now())
  note        String?

  @@unique([entityType, entityId, completedOn])
  @@index([completedOn])
  @@index([completedAt])
  @@index([entityType, entityId])
}
